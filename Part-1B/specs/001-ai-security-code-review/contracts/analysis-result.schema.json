{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:security-code-review:analysis-result:1.0",
  "title": "Final application analysis response",
  "description": "Application response after raw model response validation and application-owned field generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_summary", "findings", "overall_assessment", "metadata"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "analysis_summary": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "overall_assessment": { "type": "string", "enum": ["no_findings", "findings_present"] },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "findings": { "maxItems": 0 } },
        "required": ["findings"]
      },
      "then": { "properties": { "overall_assessment": { "const": "no_findings" } } },
      "else": {
        "properties": {
          "findings": { "minItems": 1 },
          "overall_assessment": { "const": "findings_present" }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "vulnerability_category", "title", "severity", "confidence", "line_start", "line_end", "evidence", "explanation", "remediation"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "vulnerability_category": {
          "type": "string",
          "enum": ["SQL Injection", "Command Injection", "Cross-Site Scripting", "Path Traversal", "Insecure Deserialization", "Hardcoded Credentials", "Weak Cryptographic Practices", "Insecure TLS Configuration", "Improper Access Control", "Other"]
        },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "line_start": { "type": "integer", "minimum": 1, "description": "Cross-field validator requires line_start <= line_end and line_start within metadata.source_line_count." },
        "line_end": { "type": "integer", "minimum": 1, "description": "Cross-field validator requires line_end >= line_start and line_end no greater than metadata.source_line_count." },
        "evidence": { "type": "string", "minLength": 1, "description": "Must exactly match a substring of the unchanged submitted source within the reported inclusive line range; do not normalize source text." },
        "explanation": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id", "analysis_timestamp", "source_language", "source_line_count", "model_identifier", "processing_time_ms"],
      "properties": {
        "analysis_id": { "type": "string", "minLength": 1 },
        "analysis_timestamp": { "type": "string", "format": "date-time", "description": "Must be checked with a JSON Schema validator whose date-time FormatChecker is enabled." },
        "source_language": { "type": "string", "const": "python" },
        "source_line_count": { "type": "integer", "minimum": 1 },
        "model_identifier": { "type": ["string", "null"] },
        "processing_time_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

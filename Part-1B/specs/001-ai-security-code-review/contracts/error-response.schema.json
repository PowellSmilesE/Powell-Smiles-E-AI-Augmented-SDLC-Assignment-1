{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:security-code-review:error-response:1.0",
  "title": "Analysis error response",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_code", "message"],
  "properties": {
    "error_code": { "type": "string", "enum": ["invalid_input", "provider_failure", "configuration_failure", "invalid_ai_response"] },
    "message": { "type": "string", "minLength": 1 }
  }
}
